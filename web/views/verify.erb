<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>確認信箱 — AstroChart</title>
  <style>
    :root {
      --bg: #0a0c1a; --panel: #141830; --field: #1b2038; --line: #2a3050;
      --ink: #e8e6f0; --muted: #9aa0c0; --gold: #d3b877; --danger: #d97070; --ok: #7fca92;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--bg); color: var(--ink);
      font-family: -apple-system, "PingFang TC", "Noto Sans TC", sans-serif;
      padding: 3rem 1.25rem; line-height: 1.6;
    }
    .wrap { max-width: 560px; margin: 0 auto; }
    h1 { font-family: "Songti TC", "Noto Serif TC", Georgia, serif; font-weight: 600; font-size: 1.9rem; margin: 0 0 1.25rem; }
    .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem; margin-bottom: 1.25rem; }
    button { font: inherit; }
    button.primary {
      width: 100%; background: var(--gold); border: none; border-radius: 8px;
      color: #201a08; font-weight: 600; padding: 0.7rem 1.1rem; cursor: pointer;
    }
    button.primary:disabled { opacity: 0.6; cursor: default; }
    button.copy {
      background: transparent; border: 1px solid var(--gold); color: var(--gold);
      border-radius: 7px; padding: 0.35rem 0.8rem; cursor: pointer; font-size: 0.85rem;
    }
    .muted { color: var(--muted); font-size: 0.9rem; }
    .err { color: var(--danger); min-height: 1.2em; }
    .hidden { display: none; }
    .token-box { background: var(--field); border: 1px solid var(--gold); border-radius: 10px; padding: 1rem; }
    .token-box code { display: block; word-break: break-all; font-size: 0.95rem; color: var(--gold); margin: 0.5rem 0 0.75rem; line-height: 1.5; }
    .warn { color: var(--danger); font-size: 0.85rem; font-weight: 600; margin: 0.75rem 0 0; }
    h2 { font-size: 0.95rem; color: var(--gold); letter-spacing: 0.05em; margin: 1.5rem 0 0.5rem; }
    pre { background: var(--field); border: 1px solid var(--line); border-radius: 8px; padding: 0.75rem 0.85rem; overflow-x: auto; font-size: 0.82rem; margin: 0.5rem 0; }
    pre code { color: var(--ink); }
    a { color: var(--gold); }
    .links { margin-top: 1.5rem; font-size: 0.9rem; }
    .links a { margin-right: 1.25rem; }
  </style>
</head>
<body>
<div class="wrap">
  <h1 data-i18n="title">確認你的信箱</h1>

  <div class="panel" id="confirm-panel">
    <p class="muted" data-i18n="confirmBody">點擊下方按鈕確認你的信箱，我們會立即發給你 API 金鑰。</p>
    <button class="primary" id="confirm" data-i18n="confirmBtn">確認並取得金鑰</button>
    <p class="err" id="error"></p>
  </div>

  <div class="panel token-box hidden" id="result">
    <p class="muted" data-i18n="resultIntro">驗證成功！你的 API 金鑰：</p>
    <code id="token"></code>
    <button class="copy" id="copy" data-i18n="copy">複製</button>
    <p class="warn" data-i18n="warn">此金鑰只會顯示這一次，請立即妥善保存。</p>
    <h2 data-i18n="howTitle">如何使用</h2>
    <p class="muted" data-i18n="howBody">在 API 請求中以 Authorization 標頭帶上金鑰：</p>
    <pre><code id="usage-example"></code></pre>
    <div class="links">
      <a href="/docs" data-i18n="docsLink">閱讀 API 文件</a>
      <a href="/" data-i18n="homeLink">回首頁</a>
    </div>
  </div>
</div>

<script>
(function () {
  "use strict";
  var $ = function (id) { return document.getElementById(id); };
  var params = new URLSearchParams(window.location.search);
  var lang = params.get("lang") === "en" ? "en" : "zh-TW";
  var token = params.get("token") || "";

  var I18N = {
    "zh-TW": {
      title: "確認你的信箱", confirmBody: "點擊下方按鈕確認你的信箱，我們會立即發給你 API 金鑰。",
      confirmBtn: "確認並取得金鑰", confirming: "確認中…",
      resultIntro: "驗證成功！你的 API 金鑰：", copy: "複製", copied: "已複製",
      warn: "此金鑰只會顯示這一次，請立即妥善保存。",
      howTitle: "如何使用", howBody: "在 API 請求中以 Authorization 標頭帶上金鑰：",
      docsLink: "閱讀 API 文件", homeLink: "回首頁",
      pageTitle: "確認信箱 — AstroChart", noToken: "缺少驗證權杖，請使用信中的連結。",
      genericError: "發生錯誤，請稍後再試"
    },
    "en": {
      title: "Confirm your email", confirmBody: "Click the button below to confirm your email and we'll issue your API key right away.",
      confirmBtn: "Confirm & get my key", confirming: "Confirming…",
      resultIntro: "Verified! Your API key:", copy: "Copy", copied: "Copied",
      warn: "This key is shown only once — save it now.",
      howTitle: "How to use it", howBody: "Pass the key on every API request via the Authorization header:",
      docsLink: "Read the API docs", homeLink: "Back to home",
      pageTitle: "Confirm email — AstroChart", noToken: "Missing verification token; please use the link from your email.",
      genericError: "Something went wrong; please try again later"
    }
  };
  var t = function (k) { return (I18N[lang] && I18N[lang][k]) || I18N["zh-TW"][k]; };

  function applyLang() {
    document.documentElement.lang = lang === "en" ? "en" : "zh-Hant";
    document.title = t("pageTitle");
    document.querySelectorAll("[data-i18n]").forEach(function (el) { el.textContent = t(el.getAttribute("data-i18n")); });
    document.querySelectorAll('a[href^="/docs"]').forEach(function (a) {
      a.setAttribute("href", lang === "en" ? "/docs?lang=en" : "/docs");
    });
  }
  applyLang();

  function usageSnippet(tok) {
    return 'curl https://astro-chart-api.fly.dev/api/v1/health \\\n  -H "Authorization: Bearer ' + tok + '"';
  }

  if (!token) { $("confirm").disabled = true; $("error").textContent = t("noToken"); }

  $("confirm").onclick = function () {
    $("error").textContent = "";
    var btn = $("confirm");
    btn.disabled = true;
    btn.textContent = t("confirming");
    fetch("/api/v1/verify", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token: token, lang: lang })
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, body: j }; });
    }).then(function (res) {
      if (!res.ok) {
        btn.disabled = false;
        btn.textContent = t("confirmBtn");
        $("error").textContent = (res.body.error && res.body.error.message) || t("genericError");
        return;
      }
      var key = res.body.data.token;
      $("token").textContent = key;
      $("usage-example").textContent = usageSnippet(key);
      $("confirm-panel").classList.add("hidden");
      $("result").classList.remove("hidden");
      applyLang();
    }).catch(function () {
      btn.disabled = false;
      btn.textContent = t("confirmBtn");
      $("error").textContent = t("genericError");
    });
  };

  $("copy").onclick = function () {
    var tok = $("token").textContent;
    var done = function () { $("copy").textContent = t("copied"); setTimeout(function () { $("copy").textContent = t("copy"); }, 1500); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(tok).then(done, function () {});
    } else {
      var r = document.createRange(); r.selectNode($("token"));
      var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
      try { document.execCommand("copy"); done(); } catch (e) {}
      sel.removeAllRanges();
    }
  };
})();
</script>
</body>
</html>

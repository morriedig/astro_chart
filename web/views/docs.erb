          "aspects": [
            { "planet": "木星", "aspect_type": "對分相", "orb": 5.28 },
            { "planet": "土星", "aspect_type": "合相", "orb": 5.14 },
            { "planet": "天王星", "aspect_type": "合相", "orb": 4.71 },
            { "planet": "海王星", "aspect_type": "合相", "orb": 1.55 }
          ]
        },
        {
          "planet": "水星",

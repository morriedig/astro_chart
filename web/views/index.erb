<%
  # Full IANA geographic timezone list, generated from TZInfo (same library
  # the backend validates with, so the two never drift). Grouped by region;
  # legacy aliases (GB, Egypt, Etc/*, CET, ...) are excluded.
  tz_geo_regions = %w[Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific]
  tz_by_region = TZInfo::Timezone.all_identifiers
    .select { |z| tz_geo_regions.include?(z.split("/").first) }
    .sort
    .group_by { |z| z.split("/").first }

  render_tz_options = lambda do |selected|
    out = +"<option value=\"UTC\"#{selected == 'UTC' ? ' selected' : ''}>UTC</option>"
    tz_geo_regions.each do |region|
      zones = tz_by_region[region]
      next unless zones

      out << "<optgroup label=\"#{region}\">"
      zones.each do |z|
        label = z.split("/", 2)[1].tr("_", " ")
        sel = z == selected ? " selected" : ""
        out << "<option value=\"#{z}\"#{sel}>#{label}</option>"
      end
      out << "</optgroup>"
    end
    out
  end

  # Default birth-timezone select (Asia/Taipei preselected).
  tz_options = render_tz_options.call("Asia/Taipei")
  # Optional relocation select: a blank first option means "use birthplace".
  tz_options_blank =
    "<option value=\"\" data-i18n=\"tzUseBirth\">（使用出生地時區）</option>" + render_tz_options.call(nil)
  city_field = lambda do |p|
    <<~HTML
      <div class="field field-city">
        <label for="#{p}-city" data-i18n="citySearch">城市搜尋</label>
        <div class="city-wrap">
          <input type="text" id="#{p}-city" placeholder="輸入城市（中文或英文）自動帶入座標" data-i18n-placeholder="cityPh" autocomplete="off"
                 role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="#{p}-city-drop">
          <ul class="city-drop" id="#{p}-city-drop" role="listbox" hidden></ul>
        </div>
      </div>
    HTML
  end
  person_fields = lambda do |p, date, time|
    <<~HTML
      <div class="field">
        <label for="#{p}-date" data-i18n="birthDate">出生日期</label>
        <input type="date" id="#{p}-date" value="#{date}" required>
      </div>
      <div class="field">
        <label for="#{p}-time" data-i18n="birthTime">出生時間</label>
        <input type="time" id="#{p}-time" value="#{time}" required>
      </div>
      #{city_field.call(p)}
      <div class="field">
        <label for="#{p}-lat" data-i18n="lat">緯度</label>
        <input type="number" id="#{p}-lat" step="0.0001" min="-90" max="90" value="25.0330" required>
      </div>
      <div class="field">
        <label for="#{p}-lng" data-i18n="lng">經度</label>
        <input type="number" id="#{p}-lng" step="0.0001" min="-180" max="180" value="121.5654" required>
      </div>
      <div class="field">
        <label for="#{p}-tz" data-i18n="tz">時區</label>
        <select id="#{p}-tz">#{tz_options}</select>
      </div>
    HTML
  end
%>
